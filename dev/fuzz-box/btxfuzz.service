# /etc/systemd/system/btxfuzz.service: runs the continuous fuzz loop as the unprivileged btxfuzz user.
# Install: cp btxfuzz.service /etc/systemd/system/ && systemctl daemon-reload && systemctl enable --now btxfuzz
[Unit]
Description=BTX continuous fuzzing (libFuzzer + ASan + UBSan)
After=network-online.target
Wants=network-online.target

[Service]
User=btxfuzz
Group=btxfuzz
# git and the build tools need a writable HOME; ProtectHome hides /home.
Environment=HOME=/srv/btxfuzz
ExecStart=/opt/btxfuzz-kit/fuzzbox-loop.sh
Restart=on-failure
RestartSec=300
Nice=10
# Hardening: the loop only needs to write under FUZZ_HOME and its private /tmp.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/btxfuzz
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Leave headroom for the system: 85% of the box's RAM (systemd reads a percentage of physical memory).
MemoryMax=85%
# One fuzzer killed for memory must not stop the whole service.
OOMPolicy=continue
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target

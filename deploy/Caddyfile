# Web server of btx-community.com. Plain HTTP on 8080 inside the Docker network only; TLS and
# the public side are handled by Cloudflare, which reaches this server through the tunnel.
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	@www host www.btx-community.com
	redir @www https://btx-community.com{uri} 301

	root * /srv/site/current
	encode zstd gzip
	file_server

	header {
		# The live strip reads the public API of the status page; nothing else leaves the page.
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; connect-src https://network.btx-monitoring.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	# Pages change with every merge: always revalidate. Fonts and styles may be cached briefly.
	@pages not path /static/*
	header @pages Cache-Control "no-cache"
	@static path /static/*
	header @static Cache-Control "public, max-age=3600"

	handle_errors {
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}

{% extends "base.html.j2" %}
{% block content %}
      <section class="c-intro">
        <h1 class="c-page-title">BTX<span class="c-hero__accent">.</span>community -<br>{{ ui["kicker"] }}</h1>
        <p class="c-hero__lead">{{ ui["lead"] }}</p>
      </section>

      {% with full = False %}{% include "_live.html.j2" %}{% endwith %}

      <section class="c-start" id="start" aria-labelledby="start-title">
        <h2 class="c-section-title" id="start-title">{{ ui["start.title"] }}</h2>
        <div class="c-audiences c-audiences--two">
          {% for audience in audiences %}
          <article class="c-audience c-audience--folded c-audience--{{ audience.id }}" id="{{ audience.id }}">
            <details class="c-fold c-audience__fold">
            <summary><h3 class="c-audience__title">{{ audience.title }}</h3> <span class="c-audience__count">{{ ui["start.count"].format(count=audience.steps | length) }}</span></summary>
            <p class="c-audience__text">{{ audience.text }}</p>
            <ul class="c-tasks">
              {% for step in audience.steps %}
              {% if step.href %}
              <li class="c-task">
                <a class="c-task__link" href="{{ step.href }}"{% if step.external %} rel="noopener noreferrer"{% endif %}><span>{{ step.text }}</span> <span class="c-task__arrow" aria-hidden="true">{% if step.external %}↗{% else %}→{% endif %}</span></a>
                {% if step.detail %}<p class="c-task__detail">{{ step.detail }}</p>{% endif %}
              </li>
              {% else %}
              <li class="c-task c-task--note"><strong>{{ step.text }}</strong></li>
              {% endif %}
              {% endfor %}
            </ul>
            </details>
          </article>
          {% endfor %}
        </div>
      </section>

      {% if checklists %}
      <section class="c-checks" id="check" aria-labelledby="check-title">
        <h2 class="c-section-title" id="check-title">{{ ui["checklists.title"] }}</h2>
        <div class="c-audiences c-audiences--two">
          {% for checklist in checklists %}
          <article class="c-audience c-audience--folded c-audience--check" id="{{ checklist.id }}">
            <details class="c-fold c-audience__fold">
            <summary><h3 class="c-audience__title">{{ checklist.title }}</h3> <span class="c-audience__count">{{ ui["checklists.count"].format(count=checklist.items | length) }}</span></summary>
            <ol class="c-steps">
              {% for item in checklist.items %}
              <li>{{ item }}</li>
              {% endfor %}
            </ol>
            </details>
          </article>
          {% endfor %}
        </div>
      </section>
      {% endif %}
{% endblock %}

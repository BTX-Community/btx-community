{% extends "base.html.j2" %}
{% block content %}
      <section class="c-hero">
        <p class="c-kicker">{{ ui["kicker"] }}</p>
        <h1 class="c-hero__title">BTX<span class="c-hero__accent">.</span>community</h1>
        <p class="c-hero__lead">{{ ui["lead"] }}</p>
      </section>

      <section class="c-start" id="start" aria-labelledby="start-title">
        <h2 class="c-section-title" id="start-title">{{ ui["start.title"] }}</h2>
        <div class="c-audiences">
          {% for audience in audiences %}
          <article class="c-audience c-audience--{{ audience.id }}" id="{{ audience.id }}">
            <h3 class="c-audience__title">{{ audience.title }}</h3>
            <p class="c-audience__text">{{ audience.text }}</p>
            <ol class="c-steps">
              {% for step in audience.steps %}
              <li>
                {% if step.href and step.external %}
                <a href="{{ step.href }}" rel="noopener noreferrer">{{ step.text }} <span aria-hidden="true">↗</span></a>
                {% elif step.href %}
                <a href="{{ step.href }}">{{ step.text }} <span aria-hidden="true">→</span></a>
                {% else %}
                <strong>{{ step.text }}</strong>
                {% endif %}
              </li>
              {% endfor %}
            </ol>
          </article>
          {% endfor %}
        </div>
      </section>

      {% with full = False %}{% include "_live.html.j2" %}{% endwith %}

      {% if checklists %}
      <section class="c-checks" id="check" aria-labelledby="check-title">
        <h2 class="c-section-title" id="check-title">{{ ui["checklists.title"] }}</h2>
        <div class="c-audiences">
          {% for checklist in checklists %}
          <article class="c-audience c-audience--check" id="{{ checklist.id }}">
            <h3 class="c-audience__title">{{ checklist.title }}</h3>
            <ol class="c-steps">
              {% for item in checklist.items %}
              <li>{{ item }}</li>
              {% endfor %}
            </ol>
          </article>
          {% endfor %}
        </div>
      </section>
      {% endif %}
{% endblock %}

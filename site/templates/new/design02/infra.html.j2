{% extends "design02/base.html.j2" %}
{% import "design02/_parts.html.j2" as parts %}
{% import "_draft.html.j2" as drafting with context %}
{% set t = infra.texts %}
{% set title = "Take part" %}
{% set description = page_description %}
{% set crumb = "take part / run infra" %}
{% set heading = page_title %}
{% set lead = page_lead %}
{% set guide = true %}
{% set badges = [("lime", infra.verified)] %}
{% set steps = [("roles", t.roles_title, infra.roles | length), ("paths", "Two ways to help", None)] %}
{% if infra.home %}{% if steps.append(("home-node", infra.home.title, None)) %}{% endif %}{% endif %}
{% for c in checklists %}{% if steps.append((c.id, c.title, c.items | length)) %}{% endif %}{% endfor %}
{% if steps.append(("map", t.map_title, None)) %}{% endif %}
{% if steps.append(("report", t.report_title, None)) %}{% endif %}
{% set onward = [(ui["next.network"], nav_href.network), (ui["next.projects"], nav_href.docs)] %}
{% macro map_svg(m) -%}
        <svg class="d02-map__svg d02-map__svg--{{ m.name }}" viewBox="0 0 {{ m.width }} {{ m.height }}" role="group" aria-labelledby="map-{{ m.name }}-title map-{{ m.name }}-desc" font-family="Inter, system-ui, sans-serif">
          <title id="map-{{ m.name }}-title">{{ t.map_name }}</title>
          <desc id="map-{{ m.name }}-desc">{{ t.map_desc }}</desc>
          <rect class="d02-map__frame" x="{{ m.frame[0] }}" y="{{ m.frame[1] }}" width="{{ m.frame[2] }}" height="{{ m.frame[3] }}" rx="4"/>
          {% for line in m.frame_label %}<text class="d02-map__frame-label" x="{{ line.x }}" y="{{ line.y }}" font-size="{{ m.label_size }}" font-family="JetBrains Mono, ui-monospace, monospace" aria-hidden="true">{{ line.text }}</text>{% endfor %}
          <g class="d02-map__arrows" aria-hidden="true">
            {% for arrow in m.arrows %}
            <g class="d02-map__arrow">
              {% for x1, y1, x2, y2 in arrow.segments %}<line x1="{{ x1 }}" y1="{{ y1 }}" x2="{{ x2 }}" y2="{{ y2 }}"/>{% endfor %}
              {% for points in arrow.heads %}<polygon class="d02-map__head" points="{{ points }}"/>{% endfor %}
              {% for badge in arrow.badges %}<circle class="d02-map__badge" cx="{{ badge.x }}" cy="{{ badge.y }}" r="{{ m.badge_radius }}"/><text class="d02-map__badge-text" x="{{ badge.x }}" y="{{ badge.y }}" font-size="{{ m.badge_radius * 1.3 }}" text-anchor="middle" dominant-baseline="central">{{ badge.number }}</text>{% endfor %}
              {% for line in arrow.labels %}<text class="d02-map__label" x="{{ line.x }}" y="{{ line.y }}" font-size="{{ m.label_size }}">{{ line.text }}</text>{% endfor %}
            </g>
            {% endfor %}
          </g>
          {% for box in m.boxes %}
          <a class="d02-map__node d02-map__node--{{ box.tone }}" href="{{ box.href | d }}"{% if box.external %} rel="noopener noreferrer"{% endif %} aria-label="{{ box.label }}">
            <rect x="{{ box.x }}" y="{{ box.y }}" width="{{ box.width }}" height="{{ box.height }}" rx="4"/>
            {% for line in box.title %}<text class="d02-map__title" x="{{ line.x }}" y="{{ line.y }}" font-size="{{ m.title_size }}" font-weight="600">{{ line.text }}</text>{% endfor %}
            {% if box.code %}<text class="d02-map__code" x="{{ box.code.x }}" y="{{ box.code.y }}" font-size="{{ m.code_size }}" font-family="JetBrains Mono, ui-monospace, monospace">{{ box.code.text }}</text>{% endif %}
            {% for badge in box.badges %}<circle class="d02-map__badge" cx="{{ badge.x }}" cy="{{ badge.y }}" r="{{ m.badge_radius }}"/><text class="d02-map__badge-text" x="{{ badge.x }}" y="{{ badge.y }}" font-size="{{ m.badge_radius * 1.3 }}" text-anchor="middle" dominant-baseline="central">{{ badge.number }}</text>{% endfor %}
            {% for line in box.labels %}<text class="d02-map__label" x="{{ line.x }}" y="{{ line.y }}" font-size="{{ m.label_size }}">{{ line.text }}</text>{% endfor %}
          </a>
          {% endfor %}
        </svg>
{%- endmacro %}
{% macro check(list_id, item, index) %}
          <li class="d02-checks__i">
            <input class="d02-checks__box" type="checkbox" id="{{ list_id }}-{{ index }}">
            <div class="d02-checks__body">
              <label class="d02-checks__l" for="{{ list_id }}-{{ index }}"><span class="d02-checks__n" aria-hidden="true">{{ "%02d" | format(index) }}</span>{{ parts.first(item) }}</label>
              {%- set more = parts.rest(item) %}
              {%- if more %}
              <details class="d02-checks__more"><summary class="d02-checks__sum">Details<span class="d02-sr"> on check {{ index }}</span></summary><p>{{ more }}</p></details>
              {%- endif %}
            </div>
          </li>
{%- endmacro %}
{% block content %}
      {%- set n = namespace(i=1) %}
      {#- Brief, section 5: the roles as a comparison table; each row links to its details. #}
      <section class="d02-step" id="roles" aria-labelledby="roles-title">
        {{ parts.stephead("roles", n.i, t.roles_title) }}
        <div class="d02-scroll" tabindex="0" role="region" aria-labelledby="roles-title">
          <table class="d02-tbl">
            <thead>
              <tr>
                <th scope="col">Role</th>
                <th scope="col">Kind</th>
                <th scope="col">{{ t.hardware }}</th>
                <th scope="col">{{ t.guide }}</th>
              </tr>
            </thead>
            <tbody>
              {%- for role in infra.roles %}
              <tr>
                <th scope="row"><a href="#role-{{ role.id }}">{{ role.title }}</a></th>
                <td><span class="d02-tag">{{ role.kind_label }}</span></td>
                <td>{{ role.hardware }}</td>
                <td>{% if role.guide %}<a href="{{ role.guide.href | d }}"{{ parts.rel(role.guide.external) }}>{{ role.guide.text }} {{ parts.arrow(role.guide.external) }}</a>{% else %}<span class="d02-badge d02-badge--amber">{{ t.coming }}</span>{% endif %}</td>
              </tr>
              {%- endfor %}
            </tbody>
          </table>
        </div>
        <div class="d02-folds">
          {%- for role in infra.roles %}
          <details class="d02-fold" id="role-{{ role.id }}">
            <summary class="d02-fold__sum"><span class="d02-fold__t">{{ role.title }}</span><span class="d02-fold__m">{{ role.kind_label }}</span><span class="d02-chev" aria-hidden="true"></span></summary>
            <div class="d02-fold__body">
              <dl class="d02-dl">
                <div><dt>{{ t.does }}</dt><dd>{{ role.does }}</dd></div>
                <div><dt>{{ t.hardware }}</dt><dd>{{ role.hardware }}</dd></div>
                <div><dt>{{ t.guide }}</dt><dd>
                  {%- if role.guide %}<a href="{{ role.guide.href | d }}"{{ parts.rel(role.guide.external) }}>{{ role.guide.text }} {{ parts.arrow(role.guide.external) }}</a>{% if role.guide.note %}{{ parts.note(ui["note"], role.guide.note) }}{% endif %}{% else %}<strong>{{ t.coming }}</strong>{% endif %}
                  {%- if role.coming %} <span class="d02-muted">{{ role.coming }}</span>{% endif %}
                  {%- if role.related %}
                  <ul class="d02-links">
                    {%- for link in role.related %}
                    <li><a href="{{ link.href | d }}"{{ parts.rel(link.external) }}>{{ link.text }} {{ parts.arrow(link.external) }}</a></li>
                    {%- endfor %}
                  </ul>
                  {%- endif %}
                </dd></div>
                <div><dt>{{ t.ask }}</dt><dd>{% if role.ask_href %}<a href="{{ role.ask_href | d }}"{{ parts.rel(role.ask_external) }}>{{ role.ask }} {{ parts.arrow(role.ask_external) }}</a>{% else %}{{ role.ask }}{% endif %}</dd></div>
                {%- if role.security %}
                <div><dt>Problems found</dt><dd><a href="#report">Report them privately <span aria-hidden="true">→</span></a></dd></div>
                {%- endif %}
              </dl>
            </div>
          </details>
          {%- endfor %}
        </div>
      </section>

      {%- set n.i = n.i + 1 %}
      <section class="d02-step" id="paths" aria-labelledby="paths-title">
        {{ parts.stephead("paths", n.i, "Two ways to help") }}
        <div class="d02-split">
          <article class="d02-card" id="yourself" aria-labelledby="yourself-title">
            <h3 class="d02-card__t" id="yourself-title">{{ t.yourself_title }}</h3>
            <p>{{ t.yourself_text }}</p>
            <p class="d02-src"><a href="#roles">The {{ infra.roles | length }} roles above <span aria-hidden="true">→</span></a></p>
          </article>
          <article class="d02-card" id="managed" aria-labelledby="managed-title">
            <h3 class="d02-card__t" id="managed-title">{{ t.managed_title }}</h3>
            <p>{{ t.managed_text }}</p>
            <ul class="d02-entries d02-entries--tight">
              {%- for entry in infra.managed %}
              {{ parts.entry(entry, ui) }}
              {%- endfor %}
            </ul>
            <p class="d02-meta">{{ t.managed_none }}</p>
          </article>
        </div>
      </section>

      {%- if infra.home %}
      {%- set n.i = n.i + 1 %}
      <section class="d02-step" id="home-node" aria-labelledby="home-node-title">
        {{ parts.stephead("home-node", n.i, infra.home.title) }}
        <div class="d02-cards">
          {%- for id, ptitle, items in infra.home.points %}
          <article class="d02-card" id="home-{{ id }}">
            <h3 class="d02-card__t">{{ ptitle }}</h3>
            <ul class="d02-list">
              {%- for item in items %}
              <li>{{ item }}</li>
              {%- endfor %}
            </ul>
          </article>
          {%- endfor %}
        </div>
        <ul class="d02-links d02-links--row">
          {%- for link in infra.home.links %}
          <li><a href="{{ link.href | d }}"{{ parts.rel(link.external) }}>{{ link.text }} {{ parts.arrow(link.external) }}</a></li>
          {%- endfor %}
        </ul>
      </section>
      {%- endif %}

      {#- The install checklist: one sentence per check with a real checkbox, the rest on demand.
          The boxes are for the reader only; nothing is stored. #}
      {%- for checklist in checklists %}
      {%- set n.i = n.i + 1 %}
      <section class="d02-step" id="{{ checklist.id }}" aria-labelledby="{{ checklist.id }}-title">
        {{ parts.stephead(checklist.id, n.i, checklist.title) }}
        {%- set shown = 4 %}
                <ul class="d02-checks">
          {%- for item in checklist.items[:shown] %}{{ check(checklist.id, item, loop.index) }}{% endfor %}
        </ul>
        {%- if checklist.items | length > shown %}
        <details class="d02-showall">
          <summary class="d02-showall__sum">Show all {{ checklist.items | length }} checks<span class="d02-chev" aria-hidden="true"></span></summary>
          <ul class="d02-checks">
            {%- for item in checklist.items[shown:] %}{{ check(checklist.id, item, loop.index + shown) }}{% endfor %}
          </ul>
        </details>
        {%- endif %}
      </section>
      {%- endfor %}

      {%- set n.i = n.i + 1 %}
      <section class="d02-step" id="map" aria-labelledby="map-title">
        {{ parts.stephead("map", n.i, t.map_title) }}
        <p class="d02-prose">{{ t.map_lead }}</p>
        <figure class="d02-map" aria-labelledby="map-title">
{% for m in infra.maps %}
{{ map_svg(m) }}
{% endfor %}
          <figcaption class="d02-meta">{{ infra.verified }}</figcaption>
        </figure>
        <details class="d02-fold">
          <summary class="d02-fold__sum"><span class="d02-fold__t" id="map-list-title">{{ t.list_title }}</span><span class="d02-fold__m">{{ infra.edges | length }}</span><span class="d02-chev" aria-hidden="true"></span></summary>
          <div class="d02-fold__body">
            <ol class="d02-edges" aria-labelledby="map-list-title">
              {%- for edge in infra.edges %}
              <li id="edge-{{ edge.number }}">
                <p><strong>{{ edge.path | join(" ⇄ " if edge.both else " → ") }}</strong></p>
                <p>{{ edge.text }}</p>
                <p class="d02-src"><span class="d02-muted">{{ t.source }}</span>{% for cite in edge.cites %} <a class="d02-cite" href="{{ cite.href }}" rel="noopener noreferrer"><code>{{ cite.label }}</code></a>{% endfor %}</p>
              </li>
              {%- endfor %}
            </ol>
          </div>
        </details>
      </section>

      {%- set n.i = n.i + 1 %}
      <div class="d02-step d02-step--report">
        <p class="d02-step__h d02-step__h--mark" aria-hidden="true"><span class="d02-step__n">{{ "%02d" | format(n.i) }}</span></p>
{{ drafting.report(infra) }}
      </div>
{% endblock %}

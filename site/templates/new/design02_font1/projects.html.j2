{% extends "design02_font1/base.html.j2" %}
{% import "design02_font1/_parts.html.j2" as parts %}
{% set t = projects.texts %}
{% set title = "Projects" %}
{% set description = page_description %}
{% set crumb = "build / projects" %}
{% set heading = page_title %}
{% set lead = t.lead %}
{% set steps = [] %}
{% for project in projects.projects %}{% if steps.append(("project-" ~ project.id, project.title, None)) %}{% endif %}{% endfor %}
{% if documents %}{% if steps.append(("documents", ui["documents.title"], documents | length)) %}{% endif %}{% endif %}
{% set onward = [(ui["next.infra"], nav_href.infra), (ui["next.work"], nav_href["dev-work"])] %}
{% block content %}
      {{ parts.note(ui["note"], t.caution) }}
      {%- for project in projects.projects %}
      <section class="d02-step" id="project-{{ project.id }}" aria-labelledby="project-{{ project.id }}-title">
        {{ parts.stephead("project-" ~ project.id, loop.index, project.title) }}
        <p class="d02-prose">{{ project.idea }}</p>
        <dl class="d02-dl">
          <div><dt>{{ t.today }}</dt><dd>{{ project.today }}</dd></div>
          <div><dt>{{ t.missing }}</dt><dd>{{ project.missing }}</dd></div>
          {%- if project.careful %}
          <div><dt>{{ t.careful }}</dt><dd>{{ project.careful }}</dd></div>
          {%- endif %}
          <div><dt>{{ t.start }}</dt><dd>
            <ul class="d02-links">
              {%- for link in project.start %}
              <li><a href="{{ link.href | d }}"{{ parts.rel(link.external) }}>{{ link.text }} {{ parts.arrow(link.external) }}</a></li>
              {%- endfor %}
            </ul>
          </dd></div>
          <div><dt>{{ t.ask }}</dt><dd>{% if project.ask_href %}<a href="{{ project.ask_href | d }}"{{ parts.rel(project.ask_external) }}>{{ project.ask }} {{ parts.arrow(project.ask_external) }}</a>{% else %}{{ project.ask }}{% endif %}</dd></div>
        </dl>
        <p class="d02-src"><span class="d02-muted">{{ t.source }}</span>{% for cite in project.cites %} <a class="d02-cite" href="{{ cite.href }}" rel="noopener noreferrer"><code>{{ cite.label }}</code></a>{% endfor %}</p>
      </section>
      {%- endfor %}
      <p class="d02-meta">{{ projects.verified }}</p>

      {%- if documents %}
      <section class="d02-step" id="documents" aria-labelledby="documents-title">
        {{ parts.stephead("documents", projects.projects | length + 1, ui["documents.title"]) }}
        <p class="d02-prose">{{ ui["documents.lead"] }}</p>
        <ul class="d02-docs">
          {%- for document in documents %}
          <li class="d02-doc" id="{{ document.id }}">
            <a class="d02-doc__a" href="{{ document.url }}" rel="noopener noreferrer">
              <span class="d02-doc__t">{{ document.title }} <span aria-hidden="true">↗</span></span>
              <span class="d02-doc__p">{{ document.text }}</span>
              {%- if document.status %}<span class="d02-doc__s">{{ document.status }}</span>{% endif %}
            </a>
          </li>
          {%- endfor %}
        </ul>
        <p class="d02-src"><a href="{{ repo_url }}" rel="noopener noreferrer">{{ ui["documents.repo"] }} ↗</a></p>
      </section>
      {%- endif %}
{% endblock %}

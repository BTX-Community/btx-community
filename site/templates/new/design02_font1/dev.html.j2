{% extends "design02_font1/base.html.j2" %}
{% import "design02_font1/_parts.html.j2" as parts %}
{% set title = "Build" %}
{% set description = page_description %}
{% set crumb = "build / start here" %}
{% set heading = page_title %}
{% set lead = page_lead %}
{% set guide = true %}
{% set badges = [("lime", "checked " ~ hub.checked)] %}
{% set steps = [
  ("brief", ui["hub.nav.brief"], None),
  ("begin", ui["hub.nav.begin"], hub.start | length),
  ("levels", ui["hub.nav.levels"], hub.levels | length),
  ("rules", ui["hub.nav.rules"], None),
  ("contribute", ui["hub.nav.contribute"], hub.contribute | length),
] %}
{% set onward = [(ui["next.work"], nav_href["dev-work"]), (ui["next.projects"], nav_href.docs)] %}
{% block content %}
      <section class="d02-step" id="brief" aria-labelledby="brief-title">
        {{ parts.stephead("brief", 1, ui["hub.brief.title"]) }}
        <p class="d02-prose">{{ ui["hub.brief.lead"] }}</p>
        {{ parts.terminal("ai-prompt", "prompt · paste into your AI tool", hub.brief_prompt) }}
        <p class="d02-meta" data-d02-copy-hint="ai-prompt">{{ ui["hub.brief.select"] }}</p>
        <ul class="d02-links d02-links--row">
          <li><a href="{{ hub.brief_agents }}" rel="noopener noreferrer">{{ ui["hub.brief.agents"] }} ↗</a></li>
          <li><a href="{{ hub.brief_llms }}" rel="noopener noreferrer">{{ ui["hub.brief.llms"] }} ↗</a></li>
        </ul>
        <ul class="d02-list">
          {%- for note in hub.brief_notes %}
          <li>{{ note }}</li>
          {%- endfor %}
        </ul>
        <h3 class="d02-h3" id="ai-files-title">{{ ui["hub.ai.title"] }}</h3>
        <ul class="d02-list" aria-labelledby="ai-files-title">
          <li><a href="/llms.txt"><code>llms.txt</code></a> {{ ui["hub.ai.index"] }}</li>
          <li><a href="/llms-full.txt"><code>llms-full.txt</code></a> {{ ui["hub.ai.full"] }}</li>
        </ul>
        <p class="d02-meta">{{ ui["hub.ai.english"] }}</p>
      </section>

      <section class="d02-step" id="begin" aria-labelledby="begin-title">
        {{ parts.stephead("begin", 2, ui["hub.begin.title"]) }}
        <p class="d02-prose">{{ ui["hub.begin.lead"] }}</p>
        <h3 class="d02-h3" id="first-steps">{{ ui["hub.steps.title"] }}</h3>
        <ol class="d02-todo">
          {%- for step in hub.start %}
          <li class="d02-todo__i"><a class="d02-todo__a" href="{{ step.href }}" rel="noopener noreferrer"><span class="d02-todo__n" aria-hidden="true">{{ "%02d" | format(loop.index) }}</span><span class="d02-todo__t">{{ step.text }}</span><span aria-hidden="true">↗</span></a></li>
          {%- endfor %}
        </ol>
        <p class="d02-src"><a href="{{ draft.pages['dev-work'] }}#lanes">{{ ui["hub.begin.open_lanes"] }} <span aria-hidden="true">→</span></a></p>
        <h3 class="d02-h3" id="principles-title">{{ ui["hub.principles.title"] }}</h3>
        <div class="d02-cards" role="group" aria-labelledby="principles-title">
          {%- for principle in hub.principles %}
          <article class="d02-card" id="principle-{{ principle.id }}">
            <h4 class="d02-card__t">{{ principle.title }}</h4>
            <p>{{ principle.text }}</p>
          </article>
          {%- endfor %}
        </div>
        <p class="d02-src">{{ ui["hub.checked"].format(date=hub.checked) }} <a href="{{ hub.source }}" rel="noopener noreferrer">{{ ui["hub.source"] }} ↗</a></p>
      </section>

      <section class="d02-step" id="levels" aria-labelledby="levels-title">
        {{ parts.stephead("levels", 3, ui["hub.levels.title"]) }}
        <p class="d02-prose">{{ ui["hub.levels.lead"] }}</p>
        <ul class="d02-docs">
          {%- for level in hub.levels %}
          <li class="d02-doc" id="level-{{ level.id }}">
            <a class="d02-doc__a" href="{{ level.url }}" rel="noopener noreferrer">
              <span class="d02-doc__t">{{ level.title }} <span aria-hidden="true">↗</span></span>
              <span class="d02-doc__p">{{ level.text }}</span>
            </a>
          </li>
          {%- endfor %}
        </ul>
      </section>

      <section class="d02-step" id="rules" aria-labelledby="rules-title">
        {{ parts.stephead("rules", 4, ui["hub.rules.section"]) }}
        <aside class="d02-warn" role="note">
          <svg class="d02-warn__ico" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path d="M12 3l9 16H3z M12 10v4 M12 17h.01" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <p>{{ ui["hub.rules.security"] }}</p>
        </aside>
        {%- if hub.rules %}
        <h3 class="d02-h3" id="rules-short">{{ ui["hub.rules.title"] }}</h3>
        <ol class="d02-olist">
          {%- for rule in hub.rules %}
          <li>{{ rule }}</li>
          {%- endfor %}
        </ol>
        {%- endif %}
        <ul class="d02-links d02-links--row">
          <li><a href="{{ hub.method_source }}" rel="noopener noreferrer">{{ ui["hub.rules.method"] }} ↗</a></li>
          <li><a href="{{ hub.guardrails_source }}" rel="noopener noreferrer">{{ ui["hub.rules.guardrails"] }} ↗</a></li>
        </ul>
      </section>

      <section class="d02-step" id="contribute" aria-labelledby="contribute-title">
        {{ parts.stephead("contribute", 5, ui["hub.contribute.title"]) }}
        <p class="d02-prose">{{ ui["hub.contribute.lead"] }}</p>
        <div class="d02-cards">
          {%- for loop_ in hub.contribute %}
          <article class="d02-card" id="loop-{{ loop_.id }}">
            <h3 class="d02-card__t">{{ loop_.title }}</h3>
            <p>{{ loop_.text }}</p>
            <ol class="d02-olist d02-olist--tight">
              {%- for step in loop_.steps %}
              <li>{% if step.href %}<a href="{{ step.href }}" rel="noopener noreferrer">{{ step.text }} <span aria-hidden="true">↗</span></a>{% else %}{{ step.text }}{% endif %}</li>
              {%- endfor %}
            </ol>
            <p class="d02-src"><a href="{{ loop_.url }}" rel="noopener noreferrer">{{ ui["hub.contribute.open"] }}: {{ loop_.title }} ↗</a></p>
          </article>
          {%- endfor %}
        </div>
        <p class="d02-src">{{ ui["hub.checked"].format(date=hub.checked) }} <a href="{{ hub.source }}" rel="noopener noreferrer">{{ ui["hub.source"] }} ↗</a></p>
      </section>
{% endblock %}

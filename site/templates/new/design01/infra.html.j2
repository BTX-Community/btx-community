{% extends "design01/base.html.j2" %}
{% import "design01/_parts.html.j2" as parts %}
{% import "_draft.html.j2" as drafting with context %}
{% set t = infra.texts %}
{% set title = ui["nav.infra"] %}
{% set description = page_description %}
{% set sections = [("roles", t.roles_title, infra.roles | length), ("paths", t.yourself_title ~ " or " ~ t.managed_title | lower, None)] %}
{% if infra.home %}{% if sections.append(("home-node", infra.home.title, None)) %}{% endif %}{% endif %}
{% for c in checklists %}{% if sections.append((c.id, c.title, c.items | length)) %}{% endif %}{% endfor %}
{% if sections.append(("map", t.map_title, None)) %}{% endif %}
{% if sections.append(("report", t.report_title, None)) %}{% endif %}
{% macro map_svg(m) -%}
        <svg class="map__svg map__svg--{{ m.name }}" viewBox="0 0 {{ m.width }} {{ m.height }}" role="group" aria-labelledby="map-{{ m.name }}-title map-{{ m.name }}-desc" font-family="Inter, system-ui, sans-serif">
          <title id="map-{{ m.name }}-title">{{ t.map_name }}</title>
          <desc id="map-{{ m.name }}-desc">{{ t.map_desc }}</desc>
          <rect class="map__frame" x="{{ m.frame[0] }}" y="{{ m.frame[1] }}" width="{{ m.frame[2] }}" height="{{ m.frame[3] }}" rx="8"/>
          {% for line in m.frame_label %}<text class="map__frame-label" x="{{ line.x }}" y="{{ line.y }}" font-size="{{ m.label_size }}" aria-hidden="true">{{ line.text }}</text>{% endfor %}
          <g class="map__arrows" aria-hidden="true">
            {% for arrow in m.arrows %}
            <g class="map__arrow">
              {% for x1, y1, x2, y2 in arrow.segments %}<line x1="{{ x1 }}" y1="{{ y1 }}" x2="{{ x2 }}" y2="{{ y2 }}"/>{% endfor %}
              {% for points in arrow.heads %}<polygon class="map__head" points="{{ points }}"/>{% endfor %}
              {% for badge in arrow.badges %}<circle class="map__badge" cx="{{ badge.x }}" cy="{{ badge.y }}" r="{{ m.badge_radius }}"/><text class="map__badge-text" x="{{ badge.x }}" y="{{ badge.y }}" font-size="{{ m.badge_radius * 1.3 }}" text-anchor="middle" dominant-baseline="central">{{ badge.number }}</text>{% endfor %}
              {% for line in arrow.labels %}<text class="map__label" x="{{ line.x }}" y="{{ line.y }}" font-size="{{ m.label_size }}">{{ line.text }}</text>{% endfor %}
            </g>
            {% endfor %}
          </g>
          {% for box in m.boxes %}
          <a class="map__node map__node--{{ box.tone }}" href="{{ box.href | d }}"{% if box.external %} rel="noopener noreferrer"{% endif %} aria-label="{{ box.label }}">
            <rect x="{{ box.x }}" y="{{ box.y }}" width="{{ box.width }}" height="{{ box.height }}" rx="6"/>
            {% for line in box.title %}<text class="map__title" x="{{ line.x }}" y="{{ line.y }}" font-size="{{ m.title_size }}" font-weight="600">{{ line.text }}</text>{% endfor %}
            {% if box.code %}<text class="map__code" x="{{ box.code.x }}" y="{{ box.code.y }}" font-size="{{ m.code_size }}" font-family="JetBrains Mono, ui-monospace, monospace">{{ box.code.text }}</text>{% endif %}
            {% for badge in box.badges %}<circle class="map__badge" cx="{{ badge.x }}" cy="{{ badge.y }}" r="{{ m.badge_radius }}"/><text class="map__badge-text" x="{{ badge.x }}" y="{{ badge.y }}" font-size="{{ m.badge_radius * 1.3 }}" text-anchor="middle" dominant-baseline="central">{{ badge.number }}</text>{% endfor %}
            {% for line in box.labels %}<text class="map__label" x="{{ line.x }}" y="{{ line.y }}" font-size="{{ m.label_size }}">{{ line.text }}</text>{% endfor %}
          </a>
          {% endfor %}
        </svg>
{%- endmacro %}
{% block content %}
{{ parts.pagehead("Take part", draft.pages.infra, page_title, page_lead, [("checked", infra.verified)]) }}
      <section class="sec sec--num" id="roles" aria-labelledby="roles-title">
        <h2 class="h2" id="roles-title">{{ t.roles_title }}</h2>
        <p class="prose">Compare the {{ infra.roles | length }} roles here, then open the one that fits.</p>
        {#- Compare first, then open the role that fits. The content names no owner per role, so the
            table has no owner column; "Who to ask" is in each role's details. #}
        <div class="scroll" tabindex="0" role="region" aria-labelledby="roles-title">
          <table class="tbl">
            <thead>
              <tr><th scope="col">Role</th><th scope="col">Area</th><th scope="col">{{ t.guide }}</th></tr>
            </thead>
            <tbody>
              {%- for role in infra.roles %}
              <tr>
                <th scope="row"><a href="#role-{{ role.id }}">{{ role.title }}&nbsp;<span aria-hidden="true">→</span></a></th>
                <td>{{ role.kind_label }}</td>
                <td>{% if role.guide %}<span class="stat stat--ok">Guide ready</span>{% else %}<span class="stat stat--wait">{{ t.coming }}</span>{% endif %}</td>
              </tr>
              {%- endfor %}
            </tbody>
          </table>
        </div>
        <p class="note note--note"><span class="note__label">{{ ui["note"] }}</span> <span class="note__body">{{ t.report_short }} <a href="#report">How to report&nbsp;<span aria-hidden="true">→</span></a></span></p>
        <div class="folds">
          {%- for role in infra.roles %}
          <details class="fold" id="role-{{ role.id }}">
            <summary class="fold__sum"><span class="fold__t">{{ role.title }}</span><span class="fold__meta">{{ role.kind_label }}</span></summary>
            <dl class="kv kv--in">
              <div class="kv__row"><dt>{{ t.does }}</dt><dd>{{ role.does }}</dd></div>
              <div class="kv__row"><dt>{{ t.hardware }}</dt><dd>{{ role.hardware }}</dd></div>
              <div class="kv__row"><dt>{{ t.guide }}</dt><dd>
                {%- if role.guide %}{{ parts.link(role.guide.href, role.guide.text, role.guide.external) }}{% if role.guide.note %}{{ parts.note(ui["note"], role.guide.note, "risk") }}{% endif %}{% else %}<strong>{{ t.coming }}</strong>{% endif %}
                {%- if role.coming %}<p class="meta">{{ role.coming }}</p>{% endif %}
                {%- if role.related %}
                <ul class="links">
                  {%- for link in role.related %}
                  <li>{{ parts.link(link.href, link.text, link.external) }}</li>
                  {%- endfor %}
                </ul>
                {%- endif %}
              </dd></div>
              <div class="kv__row"><dt>{{ t.ask }}</dt><dd>{% if role.ask_href %}{{ parts.link(role.ask_href, role.ask, role.ask_external) }}{% else %}{{ role.ask }}{% endif %}</dd></div>
            </dl>
          </details>
          {%- endfor %}
        </div>
        {%- if projects %}<p class="src"><a href="{{ draft.pages.projects }}">{{ projects.texts.infra_link }}&nbsp;<span aria-hidden="true">→</span></a></p>{% endif %}
      </section>

      <section class="sec sec--num" id="paths" aria-labelledby="paths-title">
        <h2 class="h2" id="paths-title">{{ t.yourself_title }} or {{ t.managed_title | lower }}</h2>
        <div class="grid grid--2">
          <article class="card" id="yourself">
            <h3 class="h3">{{ t.yourself_title }}</h3>
            <p>{{ t.yourself_text }}</p>
            <p class="src"><a href="#roles">The {{ infra.roles | length }} roles above&nbsp;<span aria-hidden="true">→</span></a></p>
          </article>
          <article class="card" id="managed">
            <h3 class="h3">{{ t.managed_title }}</h3>
            <p>{{ t.managed_text }}</p>
            <ul class="plain">
              {%- for entry in infra.managed %}
              <li class="sub-entry">
                <p class="entry__head"><a class="entry__name" href="{{ entry.url }}" rel="noopener noreferrer">{{ entry.name }}&nbsp;<span aria-hidden="true">↗</span></a> <span class="entry__host mono">{{ entry.url.split("/")[2] }}</span></p>
                <p>{{ entry.description }}</p>
                {%- if entry.note %}{{ parts.note(ui["note"], entry.note, "risk") }}{% endif %}
              </li>
              {%- endfor %}
            </ul>
            <p class="meta">{{ t.managed_none }}</p>
          </article>
        </div>
      </section>

      {%- if infra.home %}
      <section class="sec sec--num" id="home-node" aria-labelledby="home-node-title">
        <h2 class="h2" id="home-node-title">{{ infra.home.title }}</h2>
        <div class="grid grid--2">
          {%- for id, ptitle, items in infra.home.points %}
          <article class="card" id="home-{{ id }}">
            <h3 class="h3">{{ ptitle }}</h3>
            <ul class="blist">
              {%- for item in items %}
              <li>{{ item }}</li>
              {%- endfor %}
            </ul>
          </article>
          {%- endfor %}
        </div>
        <ul class="links links--row">
          {%- for link in infra.home.links %}
          <li>{{ parts.link(link.href, link.text, link.external) }}</li>
          {%- endfor %}
        </ul>
      </section>
      {%- endif %}

      {#- One sentence per check with a checkbox (kept on this page only, never stored); the rest of
          the item opens on click. With JavaScript the list starts with four checks and a button. #}
      {%- for checklist in checklists %}
      <section class="sec sec--num" id="{{ checklist.id }}" aria-labelledby="{{ checklist.id }}-title">
        <h2 class="h2" id="{{ checklist.id }}-title">{{ checklist.title }}</h2>
        <p class="prose">One line per check; the details open on click. Ticks stay on this page only.</p>
        <ol class="cks" data-d01-checks data-show="4">
          {%- for item in checklist.items %}
          {%- set parts_ = item.split(". ", 1) %}
          <li class="card ck">
            <input class="ck__box" type="checkbox" id="{{ checklist.id }}-{{ loop.index }}">
            <div class="ck__body">
              <label class="ck__label" for="{{ checklist.id }}-{{ loop.index }}">{{ parts_[0] }}{% if parts_ | length > 1 %}.{% endif %}</label>
              {%- if parts_ | length > 1 %}
              <details class="ck__more">
                <summary class="ck__sum">Details<span class="sr"> of check {{ loop.index }}</span></summary>
                <p>{{ parts_[1] }}</p>
              </details>
              {%- endif %}
            </div>
          </li>
          {%- endfor %}
        </ol>
        <button type="button" class="btn btn--secondary" data-d01-show-all hidden>Show all {{ checklist.items | length }} checks</button>
      </section>
      {%- endfor %}

      <section class="sec sec--num" id="map" aria-labelledby="map-title">
        <h2 class="h2" id="map-title">{{ t.map_title }}</h2>
        <p class="prose">{{ t.map_lead }}</p>
        <figure class="card map" aria-labelledby="map-title">
{% for m in infra.maps %}
{{ map_svg(m) }}
{% endfor %}
          <figcaption class="meta">{{ infra.verified }}</figcaption>
        </figure>
        <details class="fold">
          <summary class="fold__sum"><span class="fold__t" id="map-list-title">{{ t.list_title }}</span><span class="fold__meta">{{ infra.edges | length }}</span></summary>
          <ol class="edges" aria-labelledby="map-list-title">
            {%- for edge in infra.edges %}
            <li id="edge-{{ edge.number }}">
              <p><strong>{{ edge.path | join(" ⇄ " if edge.both else " → ") }}</strong></p>
              <p>{{ edge.text }}</p>
              <p class="src"><span class="muted">{{ t.source }}:</span>{% for cite in edge.cites %} <a href="{{ cite.href }}" rel="noopener noreferrer"><code class="code">{{ cite.label }}</code></a>{% endfor %}</p>
            </li>
            {%- endfor %}
          </ol>
        </details>
      </section>

      <div class="sec sec--num sec--report">
{{ drafting.report(infra) }}
      </div>
{% endblock %}

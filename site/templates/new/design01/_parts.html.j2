{#- Small parts the pages of draft 01 share. -#}

{#- Breadcrumb, title, lead and the badges that say how current the page is. -#}
{% macro pagehead(crumb, crumb_href, title, lead, badges=()) -%}
      <header class="ph">
        <p class="ph__crumb"><a href="{{ crumb_href }}">{{ crumb }}</a> <span aria-hidden="true">/</span> <span class="ph__here">{{ title }}</span></p>
        <h1 class="ph__title">{{ title }}</h1>
        {%- if lead %}
        <p class="ph__lead">{{ lead }}</p>
        {%- endif %}
        {%- if badges %}
        <p class="badges">
          {%- for kind, text in badges %}
          <span class="badge badge--{{ kind }}">{% if kind == "checked" %}<svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-10"/></svg>{% endif %}{{ text }}</span>
          {%- endfor %}
        </p>
        {%- endif %}
      </header>
{%- endmacro %}

{% macro arrow(external) -%}<span aria-hidden="true">{% if external %}↗{% else %}→{% endif %}</span>{%- endmacro %}

{#- A link from the content: internal links stay in the draft; external ones get rel and ↗. -#}
{% macro link(href, text, external, cls="") -%}
<a{% if cls %} class="{{ cls }}"{% endif %} href="{{ href | d }}"{% if external %} rel="noopener noreferrer"{% endif %}>{{ text }}&nbsp;{{ arrow(external) }}</a>
{%- endmacro %}

{#- A neutral note (yellow is for a risk next to an entry; red is the warnbox). -#}
{% macro note(label, body, kind="note") -%}
<p class="note note--{{ kind }}"><span class="note__label">{{ label }}</span> <span class="note__body">{{ body }}</span></p>
{%- endmacro %}

{% macro onward(links, ui) -%}
{%- if links %}
      <nav class="sec onward" aria-labelledby="onward-title">
        <h2 class="h2" id="onward-title">{{ ui["next.title"] }}</h2>
        <ul class="rows">
          {%- for label, href in links %}
          <li><a class="row" href="{{ href | d }}"><span class="row__t">{{ label }}</span><span class="row__a" aria-hidden="true">→</span></a></li>
          {%- endfor %}
        </ul>
      </nav>
{%- endif %}
{%- endmacro %}

{#- A sentence-long label and the rest of a checklist item, split at the first ". ". -#}
{% macro split_item(item) -%}
{%- set parts = item.split(". ", 1) -%}
<strong class="ck__first">{{ parts[0] }}{% if parts | length > 1 %}.{% endif %}</strong>{% if parts | length > 1 %} <span class="ck__rest">{{ parts[1] }}</span>{% endif %}
{%- endmacro %}

{% macro warn_icon() -%}
<svg class="warnbox__icon" aria-hidden="true" focusable="false" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l9.5 17h-19z"/><path d="M12 10v4M12 17h.01"/></svg>
{%- endmacro %}

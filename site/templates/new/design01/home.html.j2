{% extends "design01/base.html.j2" %}
{% import "design01/_parts.html.j2" as parts %}
{% set title = "Start" %}
{% set description = ui["meta_description"] %}
{% block main_class %}page page--home{% endblock %}
{% macro icon(id) -%}
<svg aria-hidden="true" focusable="false" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
{%- if id == "newcomers" %}<circle cx="12" cy="12" r="9"/><path d="M15.5 8.5l-2 5-5 2 2-5z"/>
{%- elif id == "miners" %}<rect x="6" y="6" width="12" height="12" rx="2"/><path d="M9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4"/>
{%- elif id == "nodes" %}<rect x="4" y="4" width="16" height="6" rx="1.5"/><rect x="4" y="14" width="16" height="6" rx="1.5"/><path d="M8 7h.01M8 17h.01"/>
{%- else %}<path d="M8 8l-4 4 4 4M16 8l4 4-4 4M13.5 5l-3 14"/>{% endif -%}
</svg>
{%- endmacro %}
{% block page %}
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__in">
        <div class="hero__text">
          <p class="kicker">{{ ui["kicker"] }}</p>
          <h1 class="hero__title" id="hero-title">{{ ui["title"] }}</h1>
          <p class="hero__lead">{{ ui["lead"] }}</p>
          <p class="actions">
            <a class="btn btn--primary" href="#newcomers">I’m new – start here&nbsp;<span aria-hidden="true">→</span></a>
            <a class="btn btn--secondary" href="{{ '/links/#cat-community' | d }}">Ask the community&nbsp;<span aria-hidden="true">→</span></a>
          </p>
        </div>
        <section class="card netcard" id="live" aria-labelledby="live-title" data-api="{{ status_api }}" data-lang="{{ lang }}"
                 data-level-green="{{ ui['level.green'] }}" data-level-yellow="{{ ui['level.yellow'] }}"
                 data-level-red="{{ ui['level.red'] }}" data-level-unknown="{{ ui['level.unknown'] }}">
          <div class="netcard__head">
            <h2 class="netcard__title" id="live-title">{{ ui["live.title"] }}</h2>
            <p class="pill"><span class="dot" aria-hidden="true"></span><span class="sr">{{ ui["live.status"] }}: </span><span data-live="overall" data-label-normal="{{ ui['overall.normal'] }}" data-label-degraded="{{ ui['overall.degraded'] }}" data-label-incident="{{ ui['overall.incident'] }}">No data</span></p>
          </div>
          <p class="note note--warn" role="alert" data-live="stale" hidden><span class="note__label">{{ ui["note"] }}</span> <span class="note__body">{{ ui["live.stale"] }}</span></p>
          <dl class="figs">
            <div class="fig"><dt>{{ ui["live.height"] }}</dt><dd class="fig__v" data-live="height">No data</dd></div>
            <div class="fig"><dt>{{ ui["live.release"] }}</dt><dd class="fig__v" data-live="release">No data</dd></div>
            <div class="fig"><dt>{{ ui["live.on_release"] }}</dt><dd class="fig__v" data-live="on-release" data-template="{{ ui['on_release'] }}">No data</dd></div>
            <div class="fig"><dt>{{ ui["live.interval"] }}</dt><dd class="fig__v" data-live="interval">No data</dd></div>
          </dl>
          <ul class="verdicts">
            {%- for id, label in verdicts %}
            <li class="verdict c-verdict--unknown" data-verdict="{{ id }}"><span class="dot" aria-hidden="true"></span>{{ label }}: <span data-verdict-label>{{ ui["level.unknown"] }}</span></li>
            {%- endfor %}
          </ul>
          <div class="fork" data-live="fork" data-template="{{ ui['fork.row'] }}" hidden>
            <p class="fork__title">{{ ui["fork.title"] }}</p>
            <ul class="fork__rows" data-live="fork-rows"></ul>
          </div>
          <p class="netcard__meta" data-live="updated" data-template="{{ ui['live.updated'] }}">{{ ui["live.loading"] }}</p>
          <p class="netcard__links"><a href="{{ draft.pages.network }}">More on the network&nbsp;<span aria-hidden="true">→</span></a> <a href="{{ status_page }}" rel="noopener noreferrer">{{ ui["live.details"] }}&nbsp;<span aria-hidden="true">↗</span></a></p>
        </section>
      </div>
    </section>

    {#- "What do you want to do?": four paths, open, with their first three linked steps. The
        audience text is cut to its first sentence; all steps, with their details, open below. #}
    <section class="band paths" id="start" aria-labelledby="paths-title">
      <div class="band__in">
        <h2 class="h2 h2--big" id="paths-title">What do you want to do?</h2>
        <p class="band__lead">Every path shows its first steps here; all steps open below each card.</p>
        <div class="paths__grid">
          {%- for audience in audiences %}
          {%- set linked = audience.steps | selectattr("href") | list %}
          {%- set notes = audience.steps | rejectattr("href") | list %}
          <article class="card path" id="{{ audience.id }}" aria-labelledby="{{ audience.id }}-title">
            <span class="path__icon">{{ icon(audience.id) }}</span>
            <div>
              <h3 class="path__title" id="{{ audience.id }}-title">{{ audience.title }}</h3>
              <p class="path__who">{{ audience.text.split(". ", 1)[0] }}{% if ". " in audience.text %}.{% endif %}</p>
            </div>
            <ol class="path__steps">
              {%- for step in linked[:3] %}
              <li>{{ parts.link(step.href, step.text, step.external) }}</li>
              {%- endfor %}
            </ol>
            {%- for step in notes %}
            {{ parts.note("Safety", step.text, "warn") }}
            {%- endfor %}
            <details class="path__all">
              <summary class="path__more">All {{ linked | length }} steps<span class="sr"> for {{ audience.title }}</span></summary>
              <ol class="path__full">
                {%- for step in linked %}
                <li>{{ parts.link(step.href, step.text, step.external) }}{% if step.detail %}<span class="path__detail">{{ step.detail }}</span>{% endif %}</li>
                {%- endfor %}
              </ol>
            </details>
          </article>
          {%- endfor %}
        </div>
      </div>
    </section>

    {#- The safety checklist as its own block, open and numbered (brief, section 4). #}
    {%- for checklist in checklists %}
    <section class="safety" id="{{ checklist.id }}" aria-labelledby="{{ checklist.id }}-title">
      <div class="band__in">
        <div class="safety__head">
          <div>
            <p class="safety__kicker">Read this once · {{ checklist.items | length }} checks</p>
            <h2 class="h2 h2--big" id="{{ checklist.id }}-title">{{ checklist.title }}</h2>
          </div>
          <a class="safety__link" href="{{ draft.pages.infra }}#before-installing">Before you install a node release&nbsp;<span aria-hidden="true">→</span></a>
        </div>
        <ol class="safety__list">
          {%- for item in checklist.items %}
          <li class="safety__item"><span class="safety__n" aria-hidden="true">{{ "%02d" | format(loop.index) }}</span><span class="safety__t">{{ parts.split_item(item) }}</span></li>
          {%- endfor %}
        </ol>
      </div>
    </section>
    {%- endfor %}

    <section class="band" aria-label="What changed, and help">
      <div class="band__in duo">
        {%- if upcoming %}
        <section class="card changed" aria-labelledby="changed-title">
          <p class="badges"><span class="badge badge--version">v{{ upcoming.version }}</span> <span class="badge badge--checked">Checked {{ upcoming.checked }}</span></p>
          <h2 class="h2" id="changed-title">What changed for you</h2>
          <ul class="changed__list">
            {%- for feature in upcoming.features %}
            <li>{{ feature.title }}</li>
            {%- endfor %}
          </ul>
          <p class="changed__links">
            <a href="{{ draft.pages.learn }}#next">All of v{{ upcoming.version }}, with sources&nbsp;<span aria-hidden="true">→</span></a>
            <a href="{{ draft.pages.learn }}#caveats">{{ ui["upcoming.caveats"] }}: {{ upcoming.caveats | length }} points&nbsp;<span aria-hidden="true">→</span></a>
          </p>
        </section>
        {%- endif %}
        <section class="card stuck" aria-labelledby="stuck-title">
          <h2 class="h2" id="stuck-title">Stuck?</h2>
          <ul class="rows">
            {%- for audience in audiences %}{% for step in audience.steps %}{% if step.href and step.href.endswith("/help/") %}
            <li><a class="row" href="{{ step.href }}" rel="noopener noreferrer"><span class="row__t">{{ step.text }}</span><span class="row__a" aria-hidden="true">↗</span></a></li>
            {%- endif %}{% endfor %}{% endfor %}
            <li><a class="row" href="{{ '/links/#cat-community' | d }}"><span class="row__t">Ask the community: the chats</span><span class="row__a" aria-hidden="true">→</span></a></li>
            <li><a class="row" href="{{ draft.pages.learn }}"><span class="row__t">{{ ui["next.learn"] }}</span><span class="row__a" aria-hidden="true">→</span></a></li>
          </ul>
        </section>
      </div>
    </section>
{% endblock %}

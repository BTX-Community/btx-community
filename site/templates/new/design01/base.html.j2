{%- import "_draft.html.j2" as drafting with context -%}
{#- Draft 01 "Klar". Five menu items by intent; each groups pages of the live site:
    Start here = Start + Learn, Take part = Mining and Running a node (on the start page) + Run infra,
    Network, Directory = Links, Build = Developers + Ongoing work + Projects. -#}
{%- set menu = [
  ("start", "Start here", draft.pages.home, [("home", ui["nav.home"], draft.pages.home), ("learn", ui["nav.learn"], draft.pages.learn)]),
  ("take", "Take part", draft.pages.infra, [("miners", "Mining", draft.pages.home ~ "#miners"), ("nodes", "Running a node", draft.pages.home ~ "#nodes"), ("infra", ui["nav.infra"], draft.pages.infra)]),
  ("network", ui["nav.network"], draft.pages.network, []),
  ("directory", "Directory", draft.pages.links, []),
  ("build", "Build", draft.pages.dev, [("dev", ui["nav.dev"], draft.pages.dev), ("dev-work", ui["subnav.dev-work"], draft.pages["dev-work"]), ("projects", ui["nav.docs"], draft.pages.projects)]),
] -%}
{%- set section_of = {"home": "start", "learn": "start", "infra": "take", "network": "network", "links": "directory", "dev": "build", "dev-work": "build", "projects": "build"} -%}
{%- set current = section_of[draft.page] -%}
{#- Reading order for "Previous / Next" at the end of every page: the menu, left to right. -#}
{%- set order = [
  ("home", ui["nav.home"]), ("learn", ui["nav.learn"]), ("infra", ui["nav.infra"]), ("network", ui["nav.network"]),
  ("links", ui["nav.links"]), ("dev", ui["nav.dev"]), ("dev-work", ui["subnav.dev-work"]), ("projects", ui["nav.docs"]),
] -%}
{#- The content file behind each page, for "Suggest an edit on GitHub". -#}
{%- set source_file = {"home": "community.yaml", "learn": "guide.yaml", "network": "texts.yaml", "links": "community.yaml", "projects": "projects.yaml", "infra": "infra.yaml", "dev": "hub.yaml", "dev-work": "hub.yaml"} -%}
{%- macro prevnext(order, source_file) %}
{%- set ids = order | map(attribute=0) | list %}
{%- set i = ids.index(draft.page) %}
    <div class="pn">
      <nav class="pn__nav" aria-label="Previous and next page">
        {%- if i > 0 %}
        <a class="pn__link" href="{{ draft.pages[order[i - 1][0]] }}"><span class="pn__k">Previous</span><span class="pn__t"><span aria-hidden="true">←</span> {{ order[i - 1][1] }}</span></a>
        {%- else %}<span></span>{% endif %}
        {%- if i + 1 < order | length %}
        <a class="pn__link pn__link--next" href="{{ draft.pages[order[i + 1][0]] }}"><span class="pn__k">Next</span><span class="pn__t">{{ order[i + 1][1] }}&nbsp;<span aria-hidden="true">→</span></span></a>
        {%- endif %}
      </nav>
      <p class="pn__edit">Something wrong or out of date? <a href="{{ repo_url }}/edit/main/site/content/{{ source_file[draft.page] }}" rel="noopener noreferrer">Suggest an edit on GitHub ↗</a></p>
    </div>
{%- endmacro %}
<!doctype html>
<html lang="en" class="d01-root" data-d01-base="{{ draft.base }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  {{ drafting.head(draft, title, description) }}
  <link rel="preload" href="/static/fonts/new/SpaceGrotesk-latin-700.woff2" as="font" type="font/woff2" crossorigin>
  <script src="{{ draft.js_urls[0] }}"></script>
  <script src="{{ js_url }}" defer></script>
  {%- for url in draft.js_urls[1:] %}
  <script src="{{ url }}" defer></script>
  {%- endfor %}
{%- block scripts %}{% endblock %}
</head>
<body class="d01">
  <a class="skip" href="#main">{{ ui["skip"] }}</a>
  {{ drafting.banner(draft) }}
  <header class="hd">
    <div class="hd__in">
      <a class="logo" href="{{ draft.pages.home }}"><span class="logo__mark" aria-hidden="true">B</span><span class="logo__name">BTX Community</span></a>
      <nav class="hd__nav" aria-label="{{ ui['nav.label'] }}">
        {%- for id, label, href, subs in menu %}
        <a class="hd__link" href="{{ href }}"{% if id == current %} aria-current="page"{% endif %}>{{ label }}</a>
        {%- endfor %}
      </nav>
      <div class="hd__tools">
        <p class="variant" aria-label="Variant of this draft">
          <a class="variant__opt" href="?v=klar" data-d01-variant="klar" aria-current="true">Klar</a><a class="variant__opt" href="?v=mono" data-d01-variant="mono">Mono</a>
        </p>
        <span class="lang" title="This draft is in English only"><span aria-hidden="true">EN</span><span class="sr">Language: English only</span></span>
        <button class="iconbtn" type="button" data-d01-theme data-to-light="{{ ui['theme.to_light'] }}" data-to-dark="{{ ui['theme.to_dark'] }}" aria-label="{{ ui['theme.to_dark'] }}" hidden>
          <svg class="iconbtn__moon" aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          <svg class="iconbtn__sun" aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
        <details class="menu">
          <summary class="iconbtn menu__btn"><svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg><span class="menu__label">Menu</span></summary>
          <nav class="sheet" aria-label="{{ ui['nav.label'] }}">
            <ul class="sheet__list">
              {%- for id, label, href, subs in menu %}
              <li>
                <a class="sheet__link" href="{{ href }}"{% if id == current %} aria-current="page"{% endif %}>{{ label }}</a>
                {%- if subs %}
                <ul class="sheet__sub">
                  {%- for sid, slabel, shref in subs %}
                  <li><a class="sheet__link sheet__link--sub" href="{{ shref }}"{% if sid == draft.page %} aria-current="page"{% endif %}>{{ slabel }}</a></li>
                  {%- endfor %}
                </ul>
                {%- endif %}
              </li>
              {%- endfor %}
            </ul>
            <p class="variant variant--sheet" aria-label="Variant of this draft">
              <a class="variant__opt" href="?v=klar" data-d01-variant="klar" aria-current="true">Klar</a><a class="variant__opt" href="?v=mono" data-d01-variant="mono">Mono</a>
            </p>
            <p class="sheet__note">This draft is in English only.</p>
          </nav>
        </details>
      </div>
    </div>
    {#- The status strip: always a word and a colour, with the time of the data; "No data" until it loads. #}
    <div class="strip" id="status-badge" data-api="{{ status_api }}" data-lang="{{ lang }}"
         data-level-green="{{ ui['level.green'] }}" data-level-yellow="{{ ui['level.yellow'] }}"
         data-level-red="{{ ui['level.red'] }}" data-level-unknown="{{ ui['level.unknown'] }}">
      <div class="strip__in">
        <p class="strip__state"><span class="dot" aria-hidden="true"></span><span class="sr">{{ ui["live.status"] }}: </span><span data-live="overall" data-label-normal="{{ ui['overall.normal'] }}" data-label-degraded="{{ ui['overall.degraded'] }}" data-label-incident="{{ ui['overall.incident'] }}">No data</span></p>
        <p class="strip__fig"><span class="strip__k">Block</span> <span class="mono" data-live="height">No data</span></p>
        <p class="strip__fig strip__fig--release"><span class="strip__k">Release</span> <span class="mono" data-live="release">No data</span></p>
        <p class="strip__fig strip__fig--wide"><span class="strip__k">{{ ui["live.on_release"] }}</span> <span class="mono" data-live="on-release" data-template="{{ ui['on_release'] }}">No data</span></p>
        <p class="strip__fig strip__fig--wide strip__time" data-live="updated" data-template="{{ ui['live.updated'] }}">{{ ui["live.loading"] }}</p>
        <a class="strip__link" href="{{ draft.pages.network }}#live">What does this mean?&nbsp;<span aria-hidden="true">→</span></a>
      </div>
    </div>
  </header>
{%- set group = (menu | selectattr(0, "equalto", current) | first)[3] %}
{%- if group and draft.page != "home" %}
  <nav class="tabs" aria-label="Pages in this part">
    <div class="tabs__in">
      {%- for sid, slabel, shref in group %}
      <a class="tabs__tab" href="{{ shref }}"{% if sid == draft.page %} aria-current="page"{% endif %}>{{ slabel }}</a>
      {%- endfor %}
    </div>
  </nav>
{%- endif %}
{%- if sections is defined and sections %}
  <div class="doc">
    <details class="otp" data-otp>
      <summary class="otp__sum">On this page <span class="otp__n">{{ sections | length }} sections</span></summary>
      <ol class="otp__list">
        {%- for id, label, count in sections %}
        <li><a class="otp__link" href="#{{ id }}">{{ label }}</a></li>
        {%- endfor %}
      </ol>
    </details>
    <nav class="rail" aria-label="On this page" data-rail>
      <p class="rail__k">On this page</p>
      <ol class="rail__list">
        {%- for id, label, count in sections %}
        <li><a class="rail__link" href="#{{ id }}"><span class="rail__t">{{ label }}</span>{% if count %} <span class="rail__n">{{ count }}</span>{% endif %}</a></li>
        {%- endfor %}
      </ol>
      {%- block rail_extra %}{% endblock %}
    </nav>
    <main id="main" class="doc__main">
{% block content %}{% endblock %}
{{ prevnext(order, source_file) }}
    </main>
  </div>
{%- else %}
  <main id="main" class="{% block main_class %}page{% endblock %}">
{% block page %}{% endblock %}
{%- if draft.page != "home" %}
{{ prevnext(order, source_file) }}
{%- endif %}
  </main>
{%- endif %}
  <footer class="ft">
    <div class="ft__in">
      <div class="ft__col">
        <p class="ft__text">{{ ui["disclaimer"] }}</p>
        {{ drafting.arrows() }}
        <p class="ft__text">{{ draft.source }}. A layout draft for feedback, in English only; the live site at <a href="{{ draft.canonical }}">btx-community.com ↗</a> is the official one.</p>
      </div>
      <nav class="ft__nav" aria-label="Pages, again">
        {%- for id, label, href, subs in menu %}
        <a href="{{ href }}">{{ label }}</a>
        {%- endfor %}
        <a href="{{ repo_url }}" rel="noopener noreferrer">{{ ui["repo"] }} ↗</a>
      </nav>
      <p class="ft__ver mono">{{ version }}</p>
    </div>
  </footer>
</body>
</html>

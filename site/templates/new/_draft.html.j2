{#- Shared by every design draft under /new/: what tells a reader, a search engine and a link
    preview that the page is a draft, and the security box every draft shows once per page. -#}

{% macro head(draft, title, description) -%}
  <meta name="robots" content="noindex, nofollow">
  <link rel="canonical" href="{{ draft.canonical }}">
  <title>[Draft] {{ title }} · {{ draft.title }}</title>
  <meta name="description" content="{{ description }}">
  <meta property="og:type" content="website">
  <meta property="og:title" content="[Draft] {{ title }} – Design draft, not the official layout">
  <meta property="og:description" content="{{ draft.summary }}">
  <link rel="icon" href="{{ icon_url }}" type="image/svg+xml">
  <link rel="icon" href="/favicon.ico" sizes="48x48">
  <link rel="apple-touch-icon" href="{{ touch_icon_url }}">
  {%- for url in draft.css_urls %}
  <link rel="stylesheet" href="{{ url }}">
  {%- endfor %}
{%- endmacro %}

{% macro banner(draft) -%}
  <div class="draft-banner" role="note">
    <p class="draft-banner__text"><strong>Design draft</strong> – not the official layout. Content may lag behind.
      <a class="draft-banner__link" href="{{ draft.feedback }}" rel="noopener noreferrer">Feedback ↗</a>
      <a class="draft-banner__link" href="{{ draft.overview }}">All drafts →</a>
      <a class="draft-banner__link" href="{{ draft.canonical }}">This page on the live site ↗</a>
    </p>
  </div>
{%- endmacro %}

{#- Security reports: the route of SECURITY.md in btxchain/btx, both ways it names. -#}
{% macro report(infra, id="report") -%}
  <aside class="warnbox" role="note" id="{{ id }}" aria-labelledby="{{ id }}-title">
    <svg class="warnbox__icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path d="M12 2 1 21h22L12 2Zm0 6 6.5 11h-13L12 8Zm-1 3v4h2v-4h-2Zm0 5v2h2v-2h-2Z" fill="currentColor"/></svg>
    <div class="warnbox__body">
      <h2 class="warnbox__title" id="{{ id }}-title">{{ infra.texts.report_title }}</h2>
      <p>{{ infra.texts.report_text }} SECURITY.md of btxchain/btx names two private ways: GitHub's private vulnerability reporting, and mail to team@btx.dev (ask for the current disclosure key before you send sensitive material).</p>
      <p class="warnbox__links">
        <a href="{{ infra.private_route }}" rel="noopener noreferrer">{{ infra.texts.report_link }} ↗</a>
        <a href="{{ infra.policy }}" rel="noopener noreferrer">{{ infra.texts.policy_link }} ↗</a>
      </p>
    </div>
  </aside>
{%- endmacro %}

{% macro arrows() -%}
  <p class="draft-arrows">→ goes to a page of this site · ↗ opens another site</p>
{%- endmacro %}

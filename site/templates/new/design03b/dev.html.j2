{% extends "design03b/base.html.j2" %}
{% import "design03b/_parts.html.j2" as parts %}
{% set title = "Developers" %}
{% set description = page_description %}
{% set pageswitch = [("dev", ui["subnav.dev"], draft.pages.dev), ("dev-work", ui["subnav.dev-work"], draft.pages["dev-work"])] %}
{#- A: the developers' start page opens with "Brief your AI". #}
{% set sections = [
  ("brief", ui["hub.nav.brief"], None),
  ("begin", ui["hub.nav.begin"], None),
  ("levels", ui["hub.nav.levels"], hub.levels | length),
  ("rules", ui["hub.nav.rules"], None),
  ("contribute", ui["hub.nav.contribute"], hub.contribute | length),
] %}
{% block content %}
{{ parts.pagehead(page_title, page_lead) }}
      <section class="sec" id="brief" aria-labelledby="brief-title">
        <h2 class="sec__title" id="brief-title">{{ ui["hub.brief.title"] }}</h2>
        <p class="prose">{{ ui["hub.brief.lead"] }}</p>
        <div class="prompt panel">
          <pre class="prompt__text" id="ai-prompt" lang="en" translate="no" tabindex="0" role="region" aria-labelledby="brief-title">{{ hub.brief_prompt }}</pre>
          <p class="prompt__bar">
            <button type="button" class="btn btn--primary c-btn--copy" data-copy="ai-prompt" data-copied="{{ ui['hub.brief.copied'] }}" hidden>{{ ui["hub.brief.copy"] }}</button>
            <span class="muted" data-copy-hint>{{ ui["hub.brief.select"] }}</span>
            <span class="sr" aria-live="polite" data-copy-status></span>
          </p>
        </div>
        <p class="src">
          <a href="{{ hub.brief_agents }}" rel="noopener noreferrer">{{ ui["hub.brief.agents"] }} ↗</a>
          <a href="{{ hub.brief_llms }}" rel="noopener noreferrer">{{ ui["hub.brief.llms"] }} ↗</a>
        </p>
        <ul class="blist">
          {%- for note in hub.brief_notes %}
          <li>{{ note }}</li>
          {%- endfor %}
        </ul>
        <h3 class="hb__h" id="ai-files-title">{{ ui["hub.ai.title"] }}</h3>
        <ul class="blist" aria-labelledby="ai-files-title">
          <li><a href="/llms.txt"><code class="code">llms.txt</code></a> {{ ui["hub.ai.index"] }}</li>
          <li><a href="/llms-full.txt"><code class="code">llms-full.txt</code></a> {{ ui["hub.ai.full"] }}</li>
        </ul>
        <p class="footnote">{{ ui["hub.ai.english"] }}</p>
      </section>

      <section class="sec" id="begin" aria-labelledby="begin-title">
        <h2 class="sec__title" id="begin-title">{{ ui["hub.begin.title"] }}</h2>
        <p class="prose">{{ ui["hub.begin.lead"] }}</p>
        <h3 class="hb__h" id="first-steps">{{ ui["hub.steps.title"] }}</h3>
        <ol class="nlist">
          {%- for step in hub.start %}
          <li><a href="{{ step.href }}" rel="noopener noreferrer">{{ step.text }} <span aria-hidden="true">↗</span></a></li>
          {%- endfor %}
        </ol>
        <p class="src"><a href="{{ draft.pages['dev-work'] }}#lanes">{{ ui["hub.begin.open_lanes"] }} →</a></p>
        <h3 class="hb__h" id="principles-title">{{ ui["hub.principles.title"] }}</h3>
        <div class="facts" role="group" aria-labelledby="principles-title">
          {%- for principle in hub.principles %}
          <article class="fact" id="principle-{{ principle.id }}">
            <h4 class="fact__t">{{ principle.title }}</h4>
            <p>{{ principle.text }}</p>
          </article>
          {%- endfor %}
        </div>
        <p class="src">{{ ui["hub.checked"].format(date=hub.checked) }} <a href="{{ hub.source }}" rel="noopener noreferrer">{{ ui["hub.source"] }} ↗</a></p>
      </section>

      <section class="sec" id="levels" aria-labelledby="levels-title">
        <h2 class="sec__title" id="levels-title">{{ ui["hub.levels.title"] }}</h2>
        <p class="prose">{{ ui["hub.levels.lead"] }}</p>
        <ul class="doclist">
          {%- for level in hub.levels %}
          <li class="doclist__item" id="level-{{ level.id }}">
            <a class="doclist__link" href="{{ level.url }}" rel="noopener noreferrer">
              <span class="doclist__title">{{ level.title }} <span aria-hidden="true">↗</span></span>
              <span class="doclist__text">{{ level.text }}</span>
            </a>
          </li>
          {%- endfor %}
        </ul>
      </section>

      <section class="sec" id="rules" aria-labelledby="rules-title">
        <h2 class="sec__title" id="rules-title">{{ ui["hub.rules.section"] }}</h2>
        <aside class="warnbox" role="note">
          <svg class="warnbox__icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path d="M12 2 1 21h22L12 2Zm0 6 6.5 11h-13L12 8Zm-1 3v4h2v-4h-2Zm0 5v2h2v-2h-2Z" fill="currentColor"/></svg>
          <div class="warnbox__body"><p>{{ ui["hub.rules.security"] }}</p></div>
        </aside>
        {%- if hub.rules %}
        <h3 class="hb__h" id="rules-short">{{ ui["hub.rules.title"] }}</h3>
        <ol class="nlist">
          {%- for rule in hub.rules %}
          <li>{{ rule }}</li>
          {%- endfor %}
        </ol>
        {%- endif %}
        <p class="src">
          <a href="{{ hub.method_source }}" rel="noopener noreferrer">{{ ui["hub.rules.method"] }} ↗</a>
          <a href="{{ hub.guardrails_source }}" rel="noopener noreferrer">{{ ui["hub.rules.guardrails"] }} ↗</a>
        </p>
      </section>

      <section class="sec" id="contribute" aria-labelledby="contribute-title">
        <h2 class="sec__title" id="contribute-title">{{ ui["hub.contribute.title"] }}</h2>
        <p class="prose">{{ ui["hub.contribute.lead"] }}</p>
        <div class="facts facts--4">
          {%- for loop_ in hub.contribute %}
          <article class="fact" id="loop-{{ loop_.id }}">
            <h3 class="fact__t">{{ loop_.title }}</h3>
            <p>{{ loop_.text }}</p>
            <ol class="nlist nlist--tight">
              {%- for step in loop_.steps %}
              <li>{% if step.href %}<a href="{{ step.href }}" rel="noopener noreferrer">{{ step.text }} <span aria-hidden="true">↗</span></a>{% else %}{{ step.text }}{% endif %}</li>
              {%- endfor %}
            </ol>
            <p class="src"><a href="{{ loop_.url }}" rel="noopener noreferrer">{{ ui["hub.contribute.open"] }}: {{ loop_.title }} ↗</a></p>
          </article>
          {%- endfor %}
        </div>
        <p class="src">{{ ui["hub.checked"].format(date=hub.checked) }} <a href="{{ hub.source }}" rel="noopener noreferrer">{{ ui["hub.source"] }} ↗</a></p>
      </section>
{% endblock %}

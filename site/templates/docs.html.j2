{% extends "base.html.j2" %}
{% block content %}
      <section class="c-intro">
        <h1 class="c-page-title">{{ page_title }}</h1>
        <p class="c-hero__lead">{{ page_lead }}</p>
      </section>

      {% if projects %}
      {% set t = projects.texts %}
      <section class="c-projects" id="projects" aria-labelledby="projects-title">
        <h2 class="c-section-title" id="projects-title">{{ t.title }}</h2>
        <p class="c-muted c-map__lead">{{ t.lead }}</p>
        <p class="c-warning">{{ t.caution }}</p>
        <div class="c-audiences">
          {% for project in projects.projects %}
          <article class="c-audience c-role c-project" id="project-{{ project.id }}">
            <h3 class="c-audience__title">{{ project.title }}</h3>
            <p class="c-audience__text">{{ project.idea }}</p>
            <dl class="c-role__facts">
              <dt>{{ t.today }}</dt>
              <dd>{{ project.today }}</dd>
              <dt>{{ t.missing }}</dt>
              <dd>{{ project.missing }}</dd>
              {% if project.careful %}
              <dt>{{ t.careful }}</dt>
              <dd class="c-project__careful">{{ project.careful }}</dd>
              {% endif %}
              <dt>{{ t.start }}</dt>
              <dd>
                <ul class="c-role__related">
                  {% for link in project.start %}
                  <li><a class="c-link" href="{{ link.href }}"{% if link.external %} rel="noopener noreferrer"{% endif %}>{{ link.text }} {% if link.external %}↗{% else %}→{% endif %}</a></li>
                  {% endfor %}
                </ul>
              </dd>
              <dt>{{ t.ask }}</dt>
              <dd>{% if project.ask_href %}<a class="c-link" href="{{ project.ask_href }}"{% if project.ask_external %} rel="noopener noreferrer"{% endif %}>{{ project.ask }} {% if project.ask_external %}↗{% else %}→{% endif %}</a>{% else %}{{ project.ask }}{% endif %}</dd>
            </dl>
            <p class="c-map__cites c-project__cites"><span class="c-map__cites-label">{{ t.source }}</span>{% for cite in project.cites %} <a class="c-link c-map__cite" href="{{ cite.href }}" rel="noopener noreferrer"><code>{{ cite.label }}</code></a>{% endfor %}</p>
          </article>
          {% endfor %}
        </div>
        <p class="c-muted c-note">{{ projects.verified }}</p>
      </section>
      {% endif %}

      {% if documents %}
      <section class="c-docs" id="documents" aria-labelledby="documents-title">
        <h2 class="c-section-title" id="documents-title">{{ ui["documents.title"] }}</h2>
        <p class="c-muted">{{ ui["documents.lead"] }}</p>
        <div class="c-audiences">
          {% for document in documents %}
          <article class="c-audience c-audience--doc" id="{{ document.id }}">
            <h3 class="c-audience__title">{{ document.title }}</h3>
            <p>{{ document.text }}</p>
            {% if document.status %}<p class="c-muted">{{ document.status }}</p>{% endif %}
            <a class="c-link c-fact__source" href="{{ document.url }}" rel="noopener noreferrer" aria-label="{{ ui['documents.open'] }}: {{ document.title }}">{{ ui["documents.open"] }} ↗</a>
          </article>
          {% endfor %}
        </div>
        <p class="c-add"><a class="c-link" href="{{ repo_url }}" rel="noopener noreferrer">{{ ui["documents.repo"] }} ↗</a></p>
      </section>
      {% endif %}
{% endblock %}

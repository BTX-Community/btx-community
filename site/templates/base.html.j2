<!doctype html>
<html lang="{{ html_lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{ page_description }}">
  <meta name="color-scheme" content="light">
  {% if noindex is defined and noindex %}<meta name="robots" content="noindex, nofollow">{% endif %}
  <title>{% if page_title %}{{ page_title }} · {% endif %}{{ ui["title"] }}</title>
  {% for code, tag, name, href in alternates %}
  <link rel="alternate" hreflang="{{ tag }}" href="{{ href }}">
  {% endfor %}
  <link rel="preload" href="/static/fonts/JetBrainsMono-Bold.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="icon" href="{{ icon_url }}" type="image/svg+xml">
  <link rel="icon" href="/favicon.ico" sizes="48x48">
  <link rel="apple-touch-icon" href="{{ touch_icon_url }}">
  <link rel="stylesheet" href="{{ css_url }}">
  <script src="{{ theme_js_url }}"></script>
  <script src="{{ js_url }}" defer></script>
{%- block scripts %}{% endblock %}
</head>
<body class="c">
  <a class="c-skip" href="#main">{{ ui["skip"] }}</a>
  <div class="c-shell">
    <header class="c-top">
      <a class="c-logo" href="{{ nav_href.home }}"><span class="c-logo__mark" aria-hidden="true"></span>BTX <span class="c-logo__slash">//</span> COMMUNITY</a>
      <nav class="c-menu" aria-label="{{ ui['nav.label'] }}">
        {% for id, label, href in nav %}
        <a class="c-menu__link{% if id == page %} c-menu__link--active{% endif %}" href="{{ href }}"{% if id == page %} aria-current="page"{% endif %}>{{ label }}</a>
        {% endfor %}
      </nav>
      <button class="c-theme" type="button" data-theme-switch data-to-light="{{ ui['theme.to_light'] }}" data-to-dark="{{ ui['theme.to_dark'] }}" aria-label="{{ ui['theme.to_light'] }}" hidden></button>
      <details class="c-lang">
        <summary class="c-chip c-chip--active" aria-label="{{ ui['lang.label'] }}: {{ ui['lang_name'] }}">{{ lang | upper }} <span aria-hidden="true">▾</span></summary>
        <nav class="c-lang__list" aria-label="{{ ui['lang.label'] }}">
          {% for code, tag, name, href in alternates %}
          <a class="c-lang__item{% if code == lang %} c-lang__item--active{% endif %}" href="{{ href }}" hreflang="{{ tag }}" lang="{{ tag }}"{% if code == lang %} aria-current="true"{% endif %}><span class="c-lang__code">{{ code | upper }}</span> {{ name }}</a>
          {% endfor %}
        </nav>
      </details>
    </header>

    <aside class="c-badge c-live--unknown" id="status-badge" data-api="{{ status_api }}" data-lang="{{ lang }}" aria-label="{{ ui['live.title'] }}">
      <a class="c-badge__head" href="{{ nav_href.network }}"><span class="c-pulse" aria-hidden="true"></span><span data-live="overall" data-label-normal="{{ ui['overall.normal'] }}" data-label-degraded="{{ ui['overall.degraded'] }}" data-label-incident="{{ ui['overall.incident'] }}">{{ ui["live.title"] }}</span></a>
      <span class="c-badge__row"><span>{{ ui["badge.block"] }}</span> <b data-live="height">–</b></span>
      <span class="c-badge__row"><span>{{ ui["badge.release"] }}</span> <b data-live="release">–</b></span>
      <span class="c-badge__row"><span>{{ ui["live.on_release"] }}</span> <b data-live="on-release" data-template="{{ ui['badge.nodes'] }}">–</b></span>
      <a class="c-link c-badge__link" href="{{ status_page }}" rel="noopener noreferrer">{{ ui["live.details"] }} ↗</a>
      <span class="c-badge__time" data-live="updated" data-template="{{ ui['live.updated'] }}"></span>
      <div class="c-badge__fork" data-live="fork" data-template="{{ ui['fork.row'] }}" hidden>
        <strong>{{ ui["fork.title"] }}</strong>
        <ul data-live="fork-rows"></ul>
        <a class="c-link" href="{{ releases_url }}" rel="noopener noreferrer">{{ ui["fork.releases"] }} ↗</a>
      </div>
    </aside>
    <main id="main">
{% block content %}{% endblock %}
    </main>

    <footer class="c-footer">
      <p>{{ ui["disclaimer"] }}</p>
      {% if translated %}<p class="c-muted">{{ ui["translation.note"] }} <a class="c-link" href="{{ translation_url }}" rel="noopener noreferrer">{{ ui["translation.fix"] }} ↗</a></p>{% endif %}
      <p>
        <a class="c-link" href="{{ repo_url }}" rel="noopener noreferrer">{{ ui["repo"] }} ↗</a>
      </p>
      <p class="c-muted">{{ version }}</p>
    </footer>
  </div>
</body>
</html>

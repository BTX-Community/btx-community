{% extends "base.html.j2" %}
{% macro map_svg(m, t) -%}
        <svg class="c-map__svg c-map__svg--{{ m.name }}" viewBox="0 0 {{ m.width }} {{ m.height }}" role="group" aria-labelledby="map-{{ m.name }}-title map-{{ m.name }}-desc" font-family="Inter, system-ui, sans-serif">
          <title id="map-{{ m.name }}-title">{{ t.map_name }}</title>
          <desc id="map-{{ m.name }}-desc">{{ t.map_desc }}</desc>
          <rect class="c-map__frame" x="{{ m.frame[0] }}" y="{{ m.frame[1] }}" width="{{ m.frame[2] }}" height="{{ m.frame[3] }}" rx="14"/>
          {% for line in m.frame_label %}<text class="c-map__frame-label" x="{{ line.x }}" y="{{ line.y }}" font-size="{{ m.label_size }}" aria-hidden="true">{{ line.text }}</text>{% endfor %}
          <g class="c-map__arrows" aria-hidden="true">
            {% for arrow in m.arrows %}
            <g class="c-map__arrow" data-edge="{{ arrow.number }}">
              {% for x1, y1, x2, y2 in arrow.segments %}<line x1="{{ x1 }}" y1="{{ y1 }}" x2="{{ x2 }}" y2="{{ y2 }}"/>{% endfor %}
              {% for points in arrow.heads %}<polygon class="c-map__head" points="{{ points }}"/>{% endfor %}
              {% for badge in arrow.badges %}<circle class="c-map__badge" cx="{{ badge.x }}" cy="{{ badge.y }}" r="{{ m.badge_radius }}"/><text class="c-map__badge-text" x="{{ badge.x }}" y="{{ badge.y }}" font-size="{{ m.badge_radius * 1.3 }}" text-anchor="middle" dominant-baseline="central">{{ badge.number }}</text>{% endfor %}
              {% for line in arrow.labels %}<text class="c-map__label" x="{{ line.x }}" y="{{ line.y }}" font-size="{{ m.label_size }}">{{ line.text }}</text>{% endfor %}
            </g>
            {% endfor %}
          </g>
          {% for box in m.boxes %}
          <a class="c-map__node c-map__node--{{ box.tone }}" href="{{ box.href }}"{% if box.external %} rel="noopener noreferrer"{% endif %} aria-label="{{ box.label }}" data-node="{{ box.id }}">
            <rect x="{{ box.x }}" y="{{ box.y }}" width="{{ box.width }}" height="{{ box.height }}" rx="10"/>
            {% for line in box.title %}<text class="c-map__title" x="{{ line.x }}" y="{{ line.y }}" font-size="{{ m.title_size }}" font-weight="600">{{ line.text }}</text>{% endfor %}
            {% if box.code %}<text class="c-map__code" x="{{ box.code.x }}" y="{{ box.code.y }}" font-size="{{ m.code_size }}" font-family="JetBrains Mono, ui-monospace, monospace">{{ box.code.text }}</text>{% endif %}
            {% for badge in box.badges %}<circle class="c-map__badge" cx="{{ badge.x }}" cy="{{ badge.y }}" r="{{ m.badge_radius }}"/><text class="c-map__badge-text" x="{{ badge.x }}" y="{{ badge.y }}" font-size="{{ m.badge_radius * 1.3 }}" text-anchor="middle" dominant-baseline="central">{{ badge.number }}</text>{% endfor %}
            {% for line in box.labels %}<text class="c-map__label" x="{{ line.x }}" y="{{ line.y }}" font-size="{{ m.label_size }}">{{ line.text }}</text>{% endfor %}
          </a>
          {% endfor %}
        </svg>
{%- endmacro %}
{% block content %}
{% set t = infra.texts %}
      <section class="c-intro">
        <h1 class="c-page-title">{{ page_title }}</h1>
        <p class="c-hero__lead">{{ page_lead }}</p>
      </section>

      <section class="c-split" id="paths" aria-label="{{ t.yourself_title }} / {{ t.managed_title }}">
        <article class="c-audience c-split__card c-split__card--yourself" id="yourself">
          <h2 class="c-audience__title">{{ t.yourself_title }}</h2>
          <p class="c-audience__text">{{ t.yourself_text }}</p>
          <nav class="c-jump" aria-label="{{ t.roles_title }}">
            {% for role in infra.roles %}
            <a class="c-chip" href="#role-{{ role.id }}">{{ role.title }}</a>
            {% endfor %}
          </nav>
        </article>
        <article class="c-audience c-split__card c-split__card--managed" id="managed">
          <h2 class="c-audience__title">{{ t.managed_title }}</h2>
          <p class="c-audience__text">{{ t.managed_text }}</p>
          {% for entry in infra.managed %}
          <div class="c-split__entry">
            <a class="c-split__name c-link" href="{{ entry.url }}" rel="noopener noreferrer">{{ entry.name }} ↗</a>
            <p class="c-card__text">{{ entry.description }}</p>
            {% if entry.note %}<p class="c-card__note">{{ entry.note }}</p>{% endif %}
          </div>
          {% endfor %}
          <p class="c-muted c-note">{{ t.managed_none }}</p>
        </article>
      </section>

      <section class="c-roles" id="roles" aria-labelledby="roles-title">
        <h2 class="c-section-title" id="roles-title">{{ t.roles_title }}</h2>
        <div class="c-audiences">
          {% for role in infra.roles %}
          <article class="c-audience c-role c-role--{{ role.kind }}" id="role-{{ role.id }}">
            <p class="c-role__kind"><span class="c-tag">{{ role.kind_label }}</span></p>
            <h3 class="c-audience__title">{{ role.title }}</h3>
            <dl class="c-role__facts">
              <dt>{{ t.does }}</dt>
              <dd>{{ role.does }}</dd>
              <dt>{{ t.hardware }}</dt>
              <dd>{{ role.hardware }}</dd>
              <dt>{{ t.guide }}</dt>
              <dd>
                {% if role.guide %}<a class="c-link" href="{{ role.guide.href }}"{% if role.guide.external %} rel="noopener noreferrer"{% endif %}>{{ role.guide.text }} {% if role.guide.external %}↗{% else %}→{% endif %}</a>{% if role.guide.note %}<span class="c-role__note c-role__guide-note">{{ role.guide.note }}</span>{% endif %}{% else %}<strong class="c-role__coming">{{ t.coming }}</strong>{% endif %}
                {% if role.coming %}<span class="c-role__note">{{ role.coming }}</span>{% endif %}
                {% if role.related %}
                <ul class="c-role__related">
                  {% for link in role.related %}
                  <li><a class="c-link" href="{{ link.href }}"{% if link.external %} rel="noopener noreferrer"{% endif %}>{{ link.text }} {% if link.external %}↗{% else %}→{% endif %}</a></li>
                  {% endfor %}
                </ul>
                {% endif %}
              </dd>
              <dt>{{ t.ask }}</dt>
              <dd>{% if role.ask_href %}<a class="c-link" href="{{ role.ask_href }}"{% if role.ask_external %} rel="noopener noreferrer"{% endif %}>{{ role.ask }} {% if role.ask_external %}↗{% else %}→{% endif %}</a>{% else %}{{ role.ask }}{% endif %}</dd>
            </dl>
            {% if role.security %}<p class="c-role__report"><a class="c-link" href="#report">{{ t.report_short }}</a></p>{% endif %}
          </article>
          {% endfor %}
        </div>
        {% if projects %}<p class="c-links c-roles__projects"><a class="c-link" href="{{ nav_href.docs }}#projects">{{ projects.texts.infra_link }} →</a></p>{% endif %}
      </section>

      <section class="c-map" id="map" aria-labelledby="map-title">
        <h2 class="c-section-title" id="map-title">{{ t.map_title }}</h2>
        <p class="c-muted c-map__lead">{{ t.map_lead }}</p>
        <figure class="c-map__figure" aria-labelledby="map-title">
{% for m in infra.maps %}
{{ map_svg(m, t) }}
{% endfor %}
          <figcaption class="c-muted c-note">{{ infra.verified }}</figcaption>
        </figure>
        <details class="c-map__details">
        <summary class="c-map__list-title" id="map-list-title">{{ t.list_title }}</summary>
        <ol class="c-map__list" aria-labelledby="map-list-title">
          {% for edge in infra.edges %}
          <li id="edge-{{ edge.number }}">
            <span class="c-map__number" aria-hidden="true">{{ edge.number }}</span>
            <div>
              <p class="c-map__pair"><strong>{{ edge.path | join(" ⇄ " if edge.both else " → ") }}</strong></p>
              <p>{{ edge.text }}</p>
              <p class="c-map__cites"><span class="c-map__cites-label">{{ t.source }}</span>{% for cite in edge.cites %} <a class="c-link c-map__cite" href="{{ cite.href }}" rel="noopener noreferrer"><code>{{ cite.label }}</code></a>{% endfor %}</p>
            </div>
          </li>
          {% endfor %}
        </ol>
        </details>
      </section>

      <section class="c-report" id="report" aria-labelledby="report-title">
        <h2 class="c-section-title" id="report-title">{{ t.report_title }}</h2>
        <p>{{ t.report_text }}</p>
        <p class="c-report__links">
          <a class="c-link" href="{{ infra.private_route }}" rel="noopener noreferrer">{{ t.report_link }} ↗</a>
          <a class="c-link" href="{{ infra.policy }}" rel="noopener noreferrer">{{ t.policy_link }} ↗</a>
        </p>
      </section>
{% endblock %}
